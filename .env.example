# Скопируйте в .env. Этот файл содержит только примеры, не реальные секреты.
# Быстрый Docker-тест: http://localhost (без HTTPS).
# Для VPS: SITE_ADDRESS=music.example.com
#          CORS_ORIGINS=["https://music.example.com"]
# SITE_ADDRESS: домен без схемы для автоматического HTTPS; :80 для HTTP.
SITE_ADDRESS=:80
CORS_ORIGINS=["http://localhost"]
HTTP_PORT=80
HTTPS_PORT=443
# Для VPS с 1 GiB RAM: API_MEMORY_LIMIT=512m, WEB_MEMORY_LIMIT=128m.
API_MEMORY_LIMIT=1g
WEB_MEMORY_LIMIT=256m

# Готовые образы из GitHub Container Registry после первого push в main:
# PRADA_IMAGE_PREFIX=ghcr.io/demlinkx/pradasound
# PRADA_IMAGE_TAG=sha-<полный SHA коммита> (или latest)
# Пустой prefix и local используются для локальной сборки.
PRADA_IMAGE_PREFIX=
PRADA_IMAGE_TAG=local

# Необязательно: метаданные YouTube через Data API.
YOUTUBE_API_KEY=

# Необязательно: Telegram Mini App. Обычный сайт работает без бота.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_MINI_APP_URL=

# По умолчанию YouTube использует iframe. Экспериментальное аудио — явно включить.
YOUTUBE_AUDIO_ENABLED=false
YOUTUBE_PROXY_URLS=[]
# Необязательно: отдельный компактный VPN-клиент, без системного TUN.
# COMPOSE_PROFILES=vpn
# VPN_UID=1000
# VPN_GID=1000
# YOUTUBE_AUDIO_ENABLED=true
# YOUTUBE_PROXY_URLS=["http://egress:1081","http://egress:1082","http://egress:1083"]
# TELEGRAM_PROXY_URL=http://egress:1080
# Необязательно: личный файл для локального yt-dlp; никогда не загружать в Git.
# YOUTUBE_COOKIES_FILE=/absolute/private/path/cookies.txt
